{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "-P",
              "-m",
              "pii_gate",
              "hook"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "-P",
              "-m",
              "pii_gate",
              "hook"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
